# Kopieren nach .env — .env ist per .gitignore ausgeschlossen.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Lokales Postgres aus docker-compose.yml (Port 5433, damit ein bereits
# laufendes lokales Postgres nicht kollidiert).
DATABASE_URL=postgres://comatch:comatch@localhost:5433/comatch

# Signiert das Admin-Session-Cookie. In Produktion zwingend ersetzen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-secret-bitte-in-produktion-ersetzen

# Basis der Teilnehmer-App — landet als URL im QR-Code des Events.
PUBLIC_WEB_URL=http://localhost:5173
# Erlaubte Origins für CORS und Socket.io (Teilnehmer-App und Admin-App).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Fotospeicher: 'local' legt unter apps/server/.uploads ab (nur Entwicklung),
# 's3' spricht einen S3-kompatiblen Bucket an (Railway Bucket in Produktion).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Wird von `npm run db:seed` als erster Admin angelegt.
ADMIN_EMAIL=admin@comatch.local
ADMIN_PASSWORD=comatch-dev

# DSGVO: So viele Stunden nach Event-Ende werden Fotos und Klarnamen gelöscht.
# Die aggregierten Zahlen für die Auswertung bleiben erhalten.
DATA_RETENTION_HOURS=24
