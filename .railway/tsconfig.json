{
  // Die Infrastrukturbeschreibung wird wie jeder andere Code typgeprüft.
  //
  // Das ist kein Selbstzweck: `railway config plan` wertet die Datei nur aus und
  // übergeht unbekannte Felder stillschweigend. Ein `dockerfilePath` an der
  // falschen Stelle erzeugt dann keinen Fehler, sondern einfach keine Wirkung —
  // und man merkt es erst, wenn der Dienst das falsche Image baut.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["railway.ts"]
}
