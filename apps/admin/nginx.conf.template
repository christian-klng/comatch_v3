# Vorlage, keine fertige Konfiguration: Das nginx-Image setzt beim Start ${PORT}
# aus der Umgebung ein. Fest auf 80 zu lauschen führte zu 502 — die Plattform
# routet auf den Port, den sie über PORT vorgibt.
#
# Der Ersetzungsfilter im Dockerfile ist dabei nicht optional: Ohne ihn würde
# envsubst auch nginx-eigene Variablen wie $uri leeren und try_files zerlegen.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  # Single-Page-Anwendung: /events/<id> existiert nicht als Datei.
  # Ohne diesen Fallback endet jeder Reload auf einer Detailseite in einem 404.
  location / {
    try_files $uri /index.html;
  }

  # Gehashte Dateinamen dürfen dauerhaft im Cache bleiben.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # index.html niemals cachen, sonst hängen Teilnehmer nach einem Deploy
  # nach einem Deploy auf einer alten Version fest.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
}
